+++ b/recipe/dapo/run_r1_dapo_qwen2.5_1.5b.sh
@@ -0,0 +1,170 @@
+#!/usr/bin/env bash
+set -xeuo pipefail
+
+
+# DAPO
+
+project_name='DAPO_new'
+exp_name='acc-nofiltering-tokenlevel-bsz-32-klloss0-clip0.2-0.28-overlong-response4'
+
+## Disable KL (Kullback-Leibler Divergence)
+adv_estimator=grpo
+use_kl_in_reward=False
+kl_coef=0.0
+use_kl_loss=False
+kl_loss_coef=0.0
+
+## Clip-Higher
+## - clip_ratio_low and clip_ratio_high specify ε_low and ε_high in the DAPO objective
+clip_ratio_low=0.2
+clip_ratio_high=0.28
+
+## Overlong Reward Shaping
+## - max_response_length - overlong_buffer_len defines the expected length.
+##   Tokens beyond that length will be penalized, controlled by overlong_penalty_factor.
+enable_overlong_buffer=true
+overlong_buffer_len=$((1024 * 6))
+overlong_penalty_factor=1.0
+max_prompt_length=$((1024 * 2))
+max_response_length=$((1024 * 4))
+
+loss_agg_mode="token-mean"
+
+## Dynamic Sampling (with Group Filtering)
+## - The trainer will repeatedly sample using gen_batch_size until enough qualified groups are found
+# for train_batch_size,
+## or the limit specified by max_num_gen_batches is reached.
+# https://verl.readthedocs.io/en/latest/algo/dapo.html#dynamic-sampling-with-group-filtering
+
+# Set to True to filter out all groups with the same output metric values.
+# For example, for accuracy (acc), groups where all outputs are 1 or 0 will be filtered.
+enable_filter_groups=False #True
+
+
+# in 32B it is filter_groups_metrix is acc
+# Options: score acc / seq_reward / seq_final_reward / ...
+# see /home/lian/verl/verl/utils/reward_score/math_dapo.py 
+# to understand how these metrics are calculated
+filter_groups_metric=acc #"seq_final_reward"
+
+# Maximum number of generation batches to sample for each training batch.
+#Non-positive values mean no upper limit
+max_num_gen_batches=-1 
+# train_batch_size = number of samples used for policy update
+train_prompt_bsz=32 
+# gen_batch_size = number of samples generated each time
+gen_prompt_bsz=192 #$((train_prompt_bsz * 3)) # each step has size 192 samples
+# each prompt will generate n responses
+n_resp_per_prompt=4
+# mini batch size for ppo update
+train_prompt_mini_bsz=32 # ppo_micro_batch_size_per_gpu=24 for 4 gpus
+
+
+### Token-level Policy Gradient
+### - Setting use_token_level_loss to True means policy gradient loss will be calculated on all tokens across all sequences in the batch.
+use_token_level_loss=True
+
+
+# Ray
+RAY_ADDRESS=${RAY_ADDRESS:-"http://localhost:8265"}
+WORKING_DIR=${WORKING_DIR:-"${PWD}"}
+RUNTIME_ENV="/home/lian/verl/verl/trainer/runtime_env.yaml"
+NNODES=${NNODES:-1}
+# Paths
+RAY_DATA_HOME=${RAY_DATA_HOME:-"/mnt/sdb/verl"}
+MODEL_PATH=/home/lian/models/qwen2.5-1.5b-instruct \
+CKPTS_DIR=${CKPTS_DIR:-"${RAY_DATA_HOME}/${project_name}/${exp_name}"}
+TRAIN_FILE=$HOME/data/countdown/train.parquet \
+TEST_FILE=$HOME/data/countdown/test.parquet \
+
+# Algorithm
+temperature=1.0
+top_p=1.0
