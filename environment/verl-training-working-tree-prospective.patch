+            # return {
+            # "score": format_score,
+            # "acc": False,
+            # "pred": 0,
+            # }
+    except:
+        if do_print:
+            print(f"Error evaluating equation")
+        return format_score
+        # return {
+        # "score": format_score,
+        # "acc": False,
+        # "pred": 0,
+        # }
